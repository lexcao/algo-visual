{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "/", "status": 301, "headers": { "Location": "/binary-search" } },
    {
      "src": "/binary-search/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/binary-search/index.html"
    },
    {
      "src": "/binary-search/(sorted-array|sorted-array-with-duplicate|rotated-sorted-array|rotated-sorted-array-with-duplicate)/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/binary-search/$1/index.html"
    },
    {
      "src": "/sorting/(bubble-sort|quick-sort)/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/sorting/$1/index.html"
    },
    {
      "src": "/graph/grid-search/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/graph/grid-search/index.html"
    },
    {
      "src": "/two-pointers/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/two-pointers/index.html"
    },
    {
      "src": "/sliding-window/?",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/sliding-window/index.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "status": 404,
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/404.html"
    }
  ]
}
