{
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "postinstall": "node node_modules/esbuild/install.js",
    "assets": "node scripts/generate-font-subset.mjs && node scripts/generate-brand-assets.mjs",
    "build": "NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production vite build && node scripts/prerender-html.mjs && node scripts/check-meta.mjs && node scripts/check-font-glyphs.mjs",
    "test:unit": "vitest run --config vitest.config.mjs",
    "test": "npm run check:fonts && vitest run --config vitest.config.mjs && node scripts/check-meta.mjs",
    "serve": "vite preview",
    "fonts": "node scripts/generate-font-subset.mjs",
    "check:fonts": "node scripts/check-font-glyphs.mjs",
    "prebuild": "npm run fonts"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-router-dom": "^5.2.0",
    "react-syntax-highlighter": "^15.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react-refresh": "^1.3.1",
    "autoprefixer": "^10.2.6",
    "fontkit": "^2.0.4",
    "postcss": "^8.3.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^2.2.2",
    "vite": "^2.3.7",
    "vitest": "^0.23.4"
  }
}
